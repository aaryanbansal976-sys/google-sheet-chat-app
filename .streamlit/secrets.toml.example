GOOGLE_SHEET_ID = "replace-with-private-synthetic-spreadsheet-id"
GOOGLE_WORKSHEET = "Messages"
# Unprefixed names use the legacy OpenAI Responses integration.
LLM_MODEL = "gpt-6-luna"
OPENAI_API_KEY = ""
# For Gemini AI Studio, set LLM_MODEL = "gemini/<verified-model-id>" and use this key:
GEMINI_API_KEY = ""
# For DeepSeek, set LLM_MODEL = "deepseek/deepseek-chat" and use this key:
DEEPSEEK_API_KEY = ""
DEMO_PASSWORD = ""
PROCESSING_ENABLED = false

[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""
client_email = ""
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""